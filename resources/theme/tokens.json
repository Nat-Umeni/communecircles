{
    "$description": "Commune Circles design tokens (W3C Design Tokens format). This is the single source of truth for colours, radii and fonts: resources/css/tokens.css is generated from it by resources/theme/vite-plugin.js, and the mobile app should read this file too.",
    "color": {
        "$type": "color",
        "white": { "$value": "#FFFFFF" },
        "forest": {
            "500": { "$value": "#689372", "$description": "Logo circle" },
            "600": { "$value": "#4A7C5F", "$description": "Hero circle outlines" },
            "700": { "$value": "#43765D", "$description": "Logo circle" },
            "800": { "$value": "#205545", "$description": "Logo circle" },
            "900": { "$value": "#184D3B", "$description": "Brand primary (deep green)" },
            "950": { "$value": "#0F3328", "$description": "Heading ink" }
        },
        "sage": {
            "50": { "$value": "#EAF1E5", "$description": "Brand secondary" },
            "100": { "$value": "#DCEFD8", "$description": "Active nav item" },
            "200": { "$value": "#D7E7CE", "$description": "Logo circle" },
            "300": { "$value": "#D2E4C7", "$description": "Logo circle" },
            "400": { "$value": "#C1DAB2", "$description": "Logo circle" },
            "500": { "$value": "#A8D5A2", "$description": "Accent: Join button, bullets, # marks" },
            "600": { "$value": "#9CBD9D", "$description": "Logo circle" }
        },
        "mist": {
            "400": { "$value": "#B2CAB9", "$description": "Logo circle (grey-green)" }
        },
        "leaf": {
            "500": { "$value": "#6E9F57", "$description": "Icon circle" },
            "700": { "$value": "#3F7D3A" }
        },
        "lime": {
            "200": { "$value": "#D3FF99", "$description": "Icon glyph" }
        },
        "stone": {
            "50": { "$value": "#F7F8F3", "$description": "Page background" },
            "200": { "$value": "#E1E6DD", "$description": "Borders and dividers" }
        },
        "ink": {
            "400": { "$value": "#8E9491" },
            "500": { "$value": "#5F6F67" },
            "900": { "$value": "#1D2A24" }
        },
        "night": {
            "50": { "$value": "#F1F7F2" },
            "100": { "$value": "#E3ECE6" },
            "300": { "$value": "#9DB0A6" },
            "500": { "$value": "#6F7F77" },
            "700": { "$value": "#263A31" },
            "800": { "$value": "#1E3A2E" },
            "850": { "$value": "#1A2E25" },
            "900": { "$value": "#15241E" },
            "950": { "$value": "#0E1A15" }
        },
        "red": {
            "400": { "$value": "#F97066" },
            "700": { "$value": "#B42318" }
        },
        "amber": {
            "400": { "$value": "#FDB022" },
            "700": { "$value": "#B54708" }
        }
    },
    "theme": {
        "light": {
            "$type": "color",
            "background": { "$value": "{color.stone.50}" },
            "surface": { "$value": "{color.white}" },
            "foreground": { "$value": "{color.ink.900}" },
            "heading": { "$value": "{color.forest.950}" },
            "muted-foreground": { "$value": "{color.ink.500}" },
            "subtle-foreground": { "$value": "{color.ink.400}" },
            "border": { "$value": "{color.stone.200}" },
            "ring": { "$value": "{color.leaf.500}" },
            "primary": { "$value": "{color.forest.900}" },
            "primary-foreground": { "$value": "{color.white}" },
            "secondary": { "$value": "{color.sage.50}" },
            "secondary-foreground": { "$value": "{color.forest.950}" },
            "accent": { "$value": "{color.sage.500}" },
            "accent-foreground": { "$value": "{color.forest.950}" },
            "highlight": { "$value": "{color.sage.100}" },
            "highlight-foreground": { "$value": "{color.forest.950}" },
            "icon": { "$value": "{color.leaf.500}" },
            "icon-foreground": { "$value": "{color.lime.200}" },
            "brand": { "$value": "{color.forest.900}" },
            "brand-foreground": { "$value": "{color.white}" },
            "brand-muted-foreground": { "$value": "{color.sage.100}" },
            "brand-decoration": { "$value": "{color.forest.600}" },
            "danger": { "$value": "{color.red.700}" },
            "danger-foreground": { "$value": "{color.white}" },
            "warning": { "$value": "{color.amber.700}" },
            "warning-foreground": { "$value": "{color.white}" },
            "success": { "$value": "{color.leaf.700}" },
            "success-foreground": { "$value": "{color.white}" }
        },
        "dark": {
            "$type": "color",
            "background": { "$value": "{color.night.950}" },
            "surface": { "$value": "{color.night.900}" },
            "foreground": { "$value": "{color.night.100}" },
            "heading": { "$value": "{color.night.50}" },
            "muted-foreground": { "$value": "{color.night.300}" },
            "subtle-foreground": { "$value": "{color.night.500}" },
            "border": { "$value": "{color.night.700}" },
            "ring": { "$value": "{color.sage.500}" },
            "primary": { "$value": "{color.sage.500}" },
            "primary-foreground": { "$value": "{color.forest.950}" },
            "secondary": { "$value": "{color.night.850}" },
            "secondary-foreground": { "$value": "{color.sage.100}" },
            "accent": { "$value": "{color.sage.500}" },
            "accent-foreground": { "$value": "{color.forest.950}" },
            "highlight": { "$value": "{color.night.800}" },
            "highlight-foreground": { "$value": "{color.sage.100}" },
            "icon": { "$value": "{color.leaf.500}" },
            "icon-foreground": { "$value": "{color.lime.200}" },
            "brand": { "$value": "{color.forest.950}" },
            "brand-foreground": { "$value": "{color.white}" },
            "brand-muted-foreground": { "$value": "{color.sage.100}" },
            "brand-decoration": { "$value": "{color.forest.600}" },
            "danger": { "$value": "{color.red.400}" },
            "danger-foreground": { "$value": "{color.night.950}" },
            "warning": { "$value": "{color.amber.400}" },
            "warning-foreground": { "$value": "{color.night.950}" },
            "success": { "$value": "{color.sage.500}" },
            "success-foreground": { "$value": "{color.forest.950}" }
        }
    },
    "radius": {
        "$type": "dimension",
        "control": { "$value": "12px", "$description": "Buttons, inputs, tabs" },
        "card": { "$value": "16px" },
        "panel": { "$value": "24px", "$description": "Hero and large panels" }
    },
    "font": {
        "$type": "fontFamily",
        "sans": { "$value": ["Nunito Sans", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Body text" },
        "heading": { "$value": ["Nunito", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Headings and wordmark" },
        "display": { "$value": ["Playfair Display", "ui-serif", "Georgia", "serif"], "$description": "Uppercase section labels under icons" }
    }
}
